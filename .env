PORT=3000

CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=your_cashfree_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key

# Change this to 5, 7.5, 10, etc.
PLATFORM_COMMISSION_PERCENT=5

# Set this to true after Easy Split is activated
# and sellers have been added as Cashfree vendors.
CASHFREE_EASY_SPLIT_ENABLED=false

# For local testing:
PUBLIC_BASE_URL=http://localhost:3000
